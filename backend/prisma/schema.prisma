generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── GRACZE ──────────────────────────────────────────
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?

  character    Character?
}

// ── POSTAĆ GRACZA ────────────────────────────────────
model Character {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level      Int @default(1)
  experience Int @default(0)

  equipment   CharacterEquipment?
  spellSlots  CharacterSpellSlots[]
  ownedItems  OwnedItem[]



  // Statystyki bazowe
  knowledge       Int @default(0)
  intelligence    Int @default(0)
  power           Int @default(0)
  endurance       Int @default(0)
  resistance      Int @default(0)
  initiative      Int @default(0)
  elementalMagic  Int @default(0)
  astralMagic     Int @default(0)
  bloodMagic      Int @default(0)

  // Zasoby
  powerShards         Int      @default(1)
  skillPoints         Int      @default(5)
  prestige            Int      @default(0)
  runicStoneShards    Int      @default(0)
  lastResourceCollect DateTime @default(now())
  maxSpells           Int      @default(2)

  // Pule akcji
  studyActions       Int      @default(30)
  explorationActions Int      @default(15)
  lastStudyRegen     DateTime @default(now())
  lastExploreRegen   DateTime @default(now())

  tower     Tower?
  spells    CharacterSpell[]
  items     CharacterItem[]
  actions   CharacterAction[]
  equipmentPresets EquipmentPreset[]
  
  battlesAsAttacker Battle[] @relation("BattleAttacker")
  battlesAsDefender Battle[] @relation("BattleDefender")
  battlesAsWinner   Battle[] @relation("BattleWinner")
  pveEncounters     PveEncounter[]
  spellbookEntries SpellbookEntry[]
  archetypeProfile ArchetypeProfile?
  archetypeTriggers ArchetypeTriggerProgress[]
  archetypeEvents   ArchetypeEventQueue[]

  tutorial  CharacterTutorial?
  homeRepairTasks HomeRepairTask[]
}


model CharacterTutorial {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  step              String  @default("INTRO")
  duelUnlockShown   Boolean @default(false)
  schoolUnlockShown Boolean @default(false)

  updatedAt   DateTime @updatedAt
}

model HomeRepairTask {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])

  taskCode    String    // "FOUNDATIONS" | "WALLS" | "FURNITURE"
  status      String    @default("locked") // locked | available | in_progress | completed
  startedAt   DateTime?
  finishesAt  DateTime?
  completedAt DateTime?

  @@unique([characterId, taskCode])
}

// ── WIEŻA ────────────────────────────────────────────
model Tower {
  id                Int       @id @default(autoincrement())
  characterId       Int       @unique
  character         Character @relation(fields: [characterId], references: [id])
  level             Int       @default(1)
  isUpgrading       Boolean   @default(false)
  upgradeFinishesAt DateTime?
  updatedAt         DateTime  @updatedAt

  buildings TowerBuilding[]
}

model TowerBuilding {
  id                Int     @id @default(autoincrement())
  towerId           Int
  tower             Tower   @relation(fields: [towerId], references: [id])
  buildingType      String
  level             Int     @default(1)
  isUpgrading       Boolean @default(false)
  upgradeFinishesAt DateTime?
  config            String  @default("{}")

  @@unique([towerId, buildingType])
}

// ── CZARY ────────────────────────────────────────────
model Spell {
  id        Int    @id @default(autoincrement())
  name      String @unique
  element   String // "fire"|"water"|"earth"|"air"|"chaos"|"life"|"death"|"harmony"|"none"
  rarity    String // "common"|"uncommon"|"rare"|"unique"
  damage    Int
  spellPool String @default("chaotic") // "chaotic"|"controlled"|"incantation"|"professional"|"master"
  castEffects String @default("[]")  // JSON array: CastEffectDef[]
  category String @default("offensive") // "offensive"|"defensive"|"summoner"
  basicCost Int     @default(0)
  isTutorialReward Boolean @default(false) // "Podstawowe Przywołanie" — gwarantowany pierwszy czar


  // ── NOWY SYSTEM STATUSÓW ──────────────────────────
  // JSON array: StatusEffectDef[]
  // Przykład: [{"type":"dot","element":"fire","damage":2,"target":"target","duration":3}]
  // Pełna specyfikacja typów w: src/types/status.types.ts
  statusEffects String @default("[]")

  // ── MECHANIKI SPECJALNE ───────────────────────────
  // Czy czar jest kierunkowy (może chybić przy miss_chance)
  isDirectional Boolean @default(true)

  // Tekst fabularny / opis efektu widoczny w logu walki
  special  String?
  descAlt  String?  // Opis gdy efekt statusu zadziałał (np. "Piorun ogłusza {target} na 2 tury!")
  endInfo  String?  // Komunikat gdy status wygasa (np. "Lód roztapia się.")


  // Mechanika przywołań
  summonCount      Int     @default(0)
  summonDamage         Int     @default(0)
  summonInitiative     Int     @default(0) 
  summonHp             Int     @default(0) 
  summonElement    String?
  summonTargetType String? // "randomEnemy"|"randomAlly"|"allEnemies"|"allAllies"|"all"|"randomAny"

  // Wymagania statystyk
  reqElementalMagic   Int @default(0)
  reqAstralMagic      Int @default(0)
  reqBloodMagic       Int @default(0)


  spellSlots  CharacterSpellSlots[]
  characters  CharacterSpell[]
  spellbookEntries SpellbookEntry[]
  allowedClasses String @default("[]")
}

model CharacterSpell {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id])
  spellId      Int
  spell        Spell     @relation(fields: [spellId], references: [id])
  isEquipped   Boolean   @default(false)
  discoveredAt DateTime  @default(now())

  @@unique([characterId, spellId])
}

// ── ARTEFAKTY ────────────────────────────────────────
model Item {
  id             Int    @id @default(autoincrement())
  name           String
  rarity         String
  slot           String
  weaponType     String?
  element        String?

  reqKnowledge        Int @default(0)
  reqIntelligence     Int @default(0)
  reqPower            Int @default(0)
  reqEndurance        Int @default(0)
  reqResistance       Int @default(0)
  reqInitiative       Int @default(0)
  reqElementalMagic   Int @default(0)
  reqAstralMagic      Int @default(0)
  reqBloodMagic       Int @default(0)


  bonusKnowledge      Int @default(0)
  bonusIntelligence   Int @default(0)
  bonusPower          Int @default(0)
  bonusEndurance      Int @default(0)
  bonusResistance     Int @default(0)
  bonusInitiative     Int @default(0)
  bonusElementalMagic Int @default(0)
  bonusAstralMagic    Int @default(0)
  bonusBloodMagic     Int @default(0)

  characters CharacterItem[]
  ownedItems OwnedItem[]
}

model OwnedItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  obtainedAt  DateTime  @default(now())

  vaultEntry ChaosVaultItem?

  equippedAsRobe     CharacterEquipment? @relation("EquipRobe")
  equippedAsBoots    CharacterEquipment? @relation("EquipBoots")
  equippedAsHat      CharacterEquipment? @relation("EquipHat")
  equippedAsAmulet   CharacterEquipment? @relation("EquipAmulet")
  equippedAsMainHand CharacterEquipment? @relation("EquipMainHand")
  equippedAsOffHand  CharacterEquipment? @relation("EquipOffHand")
  equippedAsOffHand2 CharacterEquipment? @relation("EquipOffHand2")

  @@index([characterId])
}

model CharacterItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  foundAt     DateTime  @default(now())
}

// ── AKTYWNY EKWIPUNEK POSTACI ────────────────────────
model CharacterEquipment {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  robeId     Int? @unique
  bootsId    Int? @unique
  hatId      Int? @unique
  amuletId   Int? @unique
  mainHandId Int? @unique
  offHandId  Int? @unique
  offHand2Id Int? @unique

  robe     OwnedItem? @relation("EquipRobe", fields: [robeId], references: [id])
  boots    OwnedItem? @relation("EquipBoots", fields: [bootsId], references: [id])
  hat      OwnedItem? @relation("EquipHat", fields: [hatId], references: [id])
  amulet   OwnedItem? @relation("EquipAmulet", fields: [amuletId], references: [id])
  mainHand OwnedItem? @relation("EquipMainHand", fields: [mainHandId], references: [id])
  offHand  OwnedItem? @relation("EquipOffHand", fields: [offHandId], references: [id])
  offHand2 OwnedItem? @relation("EquipOffHand2", fields: [offHand2Id], references: [id])
}

// ── AKTYWNE CZARY POSTACI ────────────────────────────
model CharacterSpellSlots {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])
  slotIndex   Int       // 0–9

  @@unique([characterId, slotIndex])
  @@unique([characterId, spellId])
}

// ── AKCJE GRACZA ─────────────────────────────────────
model CharacterAction {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  actionType  String    // "study" | "exploration"
  actionLevel Int       // 1–5
  status      String    @default("in_progress") // "in_progress"|"completed"|"claimed"
  startedAt   DateTime  @default(now())
  finishesAt  DateTime

  skillPointsEarned Int?
  spellDiscovered   String?
  report            String?

  @@index([characterId, status])
}

// ── WALKI PVP ─────────────────────────────────────────
model Battle {
  id           Int       @id @default(autoincrement())
  attackerId   Int
  attacker     Character @relation("BattleAttacker", fields: [attackerId], references: [id])
  defenderId   Int
  defender     Character @relation("BattleDefender", fields: [defenderId], references: [id])
  winnerId     Int
  winner       Character @relation("BattleWinner", fields: [winnerId], references: [id])
  log          String
  summary      String
  metadata     String    @default("{}")
  prestigeGain Int       @default(0)
  foughtAt     DateTime  @default(now())

  @@index([attackerId])
  @@index([defenderId])
}

// ── KOMNATA NIEŁADU ───────────────────────────────────
model ChaosVaultItem {
  id          Int       @id @default(autoincrement())
  ownedItemId Int       @unique
  ownedItem   OwnedItem @relation(fields: [ownedItemId], references: [id])
  addedAt     DateTime  @default(now())
}

// ── SPOTKANIA PVE ──────────────────────────────────────────────────────────────
model PveEncounter {
  id                Int       @id @default(autoincrement())
  characterId       Int
  character         Character @relation(fields: [characterId], references: [id])
 
  locationLevel     Int                    // 1–5 (poziom lokacji eksploracji)
  entityId          String                 // ID z minor-entities.ts (np. "air_wisp")
  entityName        String                 // Wyświetlana nazwa bytu
  playerWon         Boolean
  runicShardsEarned Int       @default(0)
 
  battleLog         String                 // JSON — pełny log walki (TurnLog[])
  summary           String                 // Np. "Powietrzny Błąd wygrywa po 3 turach!"
 
  foughtAt          DateTime  @default(now())
 
  @@index([characterId])
  @@index([characterId, playerWon])
}


// ── KSIĘGA MAGII ─────────────────────────────────────────────────────────────
// Śledzi, które czary gracz "odkrył" (widział w akcji/walce/szkole)
// NIE jest tym samym co posiadanie czaru (CharacterSpell)

model SpellbookEntry {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])

  // Źródło odkrycia: "study" | "battle_cast" | "school"
  source      String
  discoveredAt DateTime @default(now())

  @@unique([characterId, spellId])
  @@index([characterId])
}

// ── ARCHETYP / CHARAKTER POSTACI ─────────────────────────────────────────────

model ArchetypeProfile {

  id          Int       @id @default(autoincrement())

  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  guardianPoints   Int @default(0)
  rulerPoints      Int @default(0)
  researcherPoints Int @default(0)
  prophetPoints    Int @default(0)
  reaperPoints     Int @default(0)
  chapter          Int @default(1)
  chapterProgress  Int @default(0)

  initialPath String?
  currentEventCode String?
  finalClass  String?
  


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArchetypeTriggerProgress {
  id            Int       @id @default(autoincrement())

  characterId   Int
  character     Character @relation(fields: [characterId], references: [id])

  triggerCode   String

  triggeredAt   DateTime  @default(now())

  @@unique([characterId, triggerCode])
}

model ArchetypeEventQueue {
  id               Int       @id @default(autoincrement())

  characterId      Int
  character        Character @relation(fields: [characterId], references: [id])

  eventCode        String

  scheduledAt      DateTime

  completedAt      DateTime?

  selectedOption   Int?

  status           String    @default("pending")
  // pending | completed | expired

  createdAt        DateTime  @default(now())
}

model ArchetypeEventChoice {

  id Int @id @default(autoincrement())

  eventCode String

  optionIndex Int

  title String
  description String
  nextEventCode String?

  guardianDelta   Int @default(0)
  rulerDelta      Int @default(0)
  researcherDelta Int @default(0)
  prophetDelta    Int @default(0)
  reaperDelta     Int @default(0)
}

model EquipmentPreset {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  slotIndex   Int       // 0–9
  name        String
  hatItemId       Int?
  robeItemId      Int?
  bootsItemId     Int?
  amuletItemId    Int?
  mainHandItemId  Int?
  offHandItemId   Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, slotIndex])
  @@index([characterId])
}