generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── GRACZE ──────────────────────────────────────────
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  lastLoginAt  DateTime? 

  character    Character?
}

// ── POSTAĆ GRACZA ────────────────────────────────────
model Character {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level      Int @default(1)
  experience Int @default(0)

  equipment   CharacterEquipment?
  spellSlots  CharacterSpellSlots[]
  ownedItems  OwnedItem[]



  // Statystyki bazowe
  knowledge       Int @default(0)
  intelligence    Int @default(0)
  power           Int @default(0)
  endurance       Int @default(0)
  resistance      Int @default(0)
  initiative      Int @default(0)
  elementalMagic  Int @default(0)
  astralMagic     Int @default(0)
  bloodMagic      Int @default(0)

  // Zasoby
  powerShards         Int      @default(1)
  skillPoints         Int      @default(5)
  prestige            Int      @default(0)
  runicStoneShards    Int      @default(0)
  lastResourceCollect DateTime @default(now())
  maxSpells           Int      @default(2)

  // Rankingi — znacznik czasu ostatniego zdobycia poziomu (tie-breaker w rankingu poziomów)
  levelUpAt           DateTime @default(now())

  // Rankingi — liczniki walk PvP (klasyka piłkarska: 3/1/0)
  battleWins          Int      @default(0)
  battleLosses        Int      @default(0)
  battleDraws         Int      @default(0)

  // Rankingi — liczniki turniejów magicznych
  tournamentWins      Int      @default(0)
  tournamentLosses    Int      @default(0)
  tournamentDraws     Int      @default(0)

  // Pule akcji
  studyActions       Int      @default(30)
  explorationActions Int      @default(15)
  lastStudyRegen     DateTime @default(now())
  lastExploreRegen   DateTime @default(now())

  tower     Tower?
  spells    CharacterSpell[]
  items     CharacterItem[]
  actions   CharacterAction[]
  equipmentPresets EquipmentPreset[]
  
  battlesAsAttacker Battle[] @relation("BattleAttacker")
  battlesAsDefender Battle[] @relation("BattleDefender")
  battlesAsWinner   Battle[] @relation("BattleWinner")
  pveEncounters     PveEncounter[]
  spellbookEntries SpellbookEntry[]
  utilitySlots             CharacterUtilitySlots[]
  tournamentsAsChallenger  MagicTournament[] @relation("TournamentChallenger")
  tournamentsAsDefender    MagicTournament[] @relation("TournamentDefender")
  tournamentsAsWinner      MagicTournament[] @relation("TournamentWinner")

  tutorial  CharacterTutorial?
  homeRepairTasks HomeRepairTask[]
  trophies  CharacterTrophy[]
  systemMessages       SystemMessage[]
  seenRandomMessages    SeenRandomMessage[]
  dailyMessageRoll      DailyMessageRoll?
  conversationsAsA      Conversation[] @relation("ConversationAsA")
  conversationsAsB      Conversation[] @relation("ConversationAsB")
  privateMessagesSent   PrivateMessage[] @relation("MessagesSent")
  blocksIssued          BlockedPlayer[] @relation("BlocksIssued")
  blocksReceived        BlockedPlayer[] @relation("BlocksReceived")

}


model CharacterTutorial {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  step              String  @default("INTRO")
  duelUnlockShown   Boolean @default(false)
  schoolUnlockShown Boolean @default(false)

  updatedAt   DateTime @updatedAt
}

model HomeRepairTask {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])

  taskCode    String    // "FOUNDATIONS" | "WALLS" | "FURNITURE"
  status      String    @default("locked") // locked | available | in_progress | completed
  startedAt   DateTime?
  finishesAt  DateTime?
  completedAt DateTime?

  @@unique([characterId, taskCode])
}

// ── WIEŻA ────────────────────────────────────────────
model Tower {
  id                Int       @id @default(autoincrement())
  characterId       Int       @unique
  character         Character @relation(fields: [characterId], references: [id])
  level             Int       @default(1)
  isUpgrading       Boolean   @default(false)
  upgradeFinishesAt DateTime?
  updatedAt         DateTime  @updatedAt

  buildings TowerBuilding[]
}

model TowerBuilding {
  id                Int     @id @default(autoincrement())
  towerId           Int
  tower             Tower   @relation(fields: [towerId], references: [id])
  buildingType      String
  level             Int     @default(1)
  isUpgrading       Boolean @default(false)
  upgradeFinishesAt DateTime?
  config            String  @default("{}")

  @@unique([towerId, buildingType])
}

// ── CZARY ────────────────────────────────────────────
model Spell {
  id        Int    @id @default(autoincrement())
  name      String @unique
  element   String // "fire"|"water"|"earth"|"air"|"chaos"|"life"|"death"|"harmony"|"none"
  rarity    String // "common"|"uncommon"|"rare"|"unique"
  damage    Int
  spellPool String @default("chaotic") // "chaotic"|"controlled"|"incantation"|"professional"|"master"
  castEffects String @default("[]")  // JSON array: CastEffectDef[]
  category String @default("offensive") // "offensive"|"defensive"|"summoner"
  basicCost Int     @default(0)
  isTutorialReward Boolean @default(false) // "Podstawowe Przywołanie" — gwarantowany pierwszy czar


  // ── NOWY SYSTEM STATUSÓW ──────────────────────────
  // JSON array: StatusEffectDef[]
  // Przykład: [{"type":"dot","element":"fire","damage":2,"target":"target","duration":3}]
  // Pełna specyfikacja typów w: src/types/status.types.ts
  statusEffects String @default("[]")

  // ── MECHANIKI SPECJALNE ───────────────────────────
  // Czy czar jest kierunkowy (może chybić przy miss_chance)
  isDirectional Boolean @default(true)

  // Tekst fabularny / opis efektu widoczny w logu walki
  special  String?
  descAlt  String?  // Opis gdy efekt statusu zadziałał (np. "Piorun ogłusza {target} na 2 tury!")
  endInfo  String?  // Komunikat gdy status wygasa (np. "Lód roztapia się.")
  spellbookDescription String @default("")  // opis prezentacyjny używany WYŁĄCZNIE w Księdze Magii (kafelek + modal)


  // Mechanika przywołań
  summonCount      Int     @default(0)
  summonDamage         Int     @default(0)
  summonInitiative     Int     @default(0) 
  summonHp             Int     @default(0) 
  summonElement    String?
  summonTargetType String? // "randomEnemy"|"randomAlly"|"allEnemies"|"allAllies"|"all"|"randomAny"

  // Wymagania statystyk
  reqElementalMagic   Int @default(0)
  reqAstralMagic      Int @default(0)
  reqBloodMagic       Int @default(0)


  spellSlots  CharacterSpellSlots[]
  characters  CharacterSpell[]
  spellbookEntries SpellbookEntry[]
  allowedClasses String @default("[]")
  utilitySlots CharacterUtilitySlots[]
  spellType       String  @default("combat")    // "combat" | "utility"
  utilityEffect   String  @default("{}")        // JSON: UtilityEffectDef
  utilityDescriptions String @default("{}")     // JSON: { "1": "...", "2": "...", "3": "...", "4": "...", "5": "..." }
}

model CharacterSpell {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id])
  spellId      Int
  spell        Spell     @relation(fields: [spellId], references: [id])
  isEquipped   Boolean   @default(false)
  discoveredAt DateTime  @default(now())

  @@unique([characterId, spellId])
}

// ── ARTEFAKTY ────────────────────────────────────────
model Item {
  id             Int    @id @default(autoincrement())
  name           String
  rarity         String
  slot           String
  weaponType     String?
  element        String?

  reqKnowledge        Int @default(0)
  reqIntelligence     Int @default(0)
  reqPower            Int @default(0)
  reqEndurance        Int @default(0)
  reqResistance       Int @default(0)
  reqInitiative       Int @default(0)
  reqElementalMagic   Int @default(0)
  reqAstralMagic      Int @default(0)
  reqBloodMagic       Int @default(0)


  bonusKnowledge      Int @default(0)
  bonusIntelligence   Int @default(0)
  bonusPower          Int @default(0)
  bonusEndurance      Int @default(0)
  bonusResistance     Int @default(0)
  bonusInitiative     Int @default(0)
  bonusElementalMagic Int @default(0)
  bonusAstralMagic    Int @default(0)
  bonusBloodMagic     Int @default(0)

  characters CharacterItem[]
  ownedItems OwnedItem[]
  baseReqs      String   @default("{}")     // JSON: bazowe wymagania przed skalowaniem tierem
  baseBonus     String   @default("{}")     // JSON: bazowe bonusy przed skalowaniem tierem
  locationTypes String   @default("[]")     // JSON: ["A"] | ["A","B"] | ["A","B","C"] itd.
}

model OwnedItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  obtainedAt  DateTime  @default(now())
  tier Int @default(1)   // 1–10, losowany przy dropie

  vaultEntry ChaosVaultItem?

  equippedAsRobe     CharacterEquipment? @relation("EquipRobe")
  equippedAsBoots    CharacterEquipment? @relation("EquipBoots")
  equippedAsHat      CharacterEquipment? @relation("EquipHat")
  equippedAsTalisman   CharacterEquipment? @relation("EquipTalisman")
  equippedAsMainHand CharacterEquipment? @relation("EquipMainHand")
  equippedAsOffHand  CharacterEquipment? @relation("EquipOffHand")
  equippedAsOffHand2 CharacterEquipment? @relation("EquipOffHand2")

  @@index([characterId])
}

model CharacterItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  foundAt     DateTime  @default(now())
}

// ── AKTYWNY EKWIPUNEK POSTACI ────────────────────────
model CharacterEquipment {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  robeId     Int? @unique
  bootsId    Int? @unique
  hatId      Int? @unique
  talismanId   Int? @unique
  mainHandId Int? @unique
  offHandId  Int? @unique
  offHand2Id Int? @unique

  robe     OwnedItem? @relation("EquipRobe", fields: [robeId], references: [id])
  boots    OwnedItem? @relation("EquipBoots", fields: [bootsId], references: [id])
  hat      OwnedItem? @relation("EquipHat", fields: [hatId], references: [id])
  talisman   OwnedItem? @relation("EquipTalisman", fields: [talismanId], references: [id])
  mainHand OwnedItem? @relation("EquipMainHand", fields: [mainHandId], references: [id])
  offHand  OwnedItem? @relation("EquipOffHand", fields: [offHandId], references: [id])
  offHand2 OwnedItem? @relation("EquipOffHand2", fields: [offHand2Id], references: [id])
}

// ── AKTYWNE CZARY POSTACI ────────────────────────────
model CharacterSpellSlots {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])
  slotIndex   Int       // 0–9

  @@unique([characterId, slotIndex])
  @@unique([characterId, spellId])
}

// ── AKCJE GRACZA ─────────────────────────────────────
model CharacterAction {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  actionType  String    // "study" | "exploration"
  actionLevel Int       // 1–5
  status      String    @default("in_progress") // "in_progress"|"completed"|"claimed"
  startedAt   DateTime  @default(now())
  finishesAt  DateTime
  actionSubcategory Int?   // 1, 2 lub 3; null dla starych rekordów


  skillPointsEarned Int?
  spellDiscovered   String?
  report            String?

  @@index([characterId, status])
  explorationLocation  String?  // "A" | "B" | "C" — litera podkategorii eksploracji
}

// ── WALKI PVP ─────────────────────────────────────────
model Battle {
  id           Int       @id @default(autoincrement())
  attackerId   Int
  attacker     Character @relation("BattleAttacker", fields: [attackerId], references: [id])
  defenderId   Int
  defender     Character @relation("BattleDefender", fields: [defenderId], references: [id])
  winnerId     Int
  winner       Character @relation("BattleWinner", fields: [winnerId], references: [id])
  log          String
  summary      String
  metadata     String    @default("{}")
  prestigeGain Int       @default(0)
  foughtAt     DateTime  @default(now())

  @@index([attackerId])
  @@index([defenderId])
}

// ── KOMNATA NIEŁADU ───────────────────────────────────
model ChaosVaultItem {
  id          Int       @id @default(autoincrement())
  ownedItemId Int       @unique
  ownedItem   OwnedItem @relation(fields: [ownedItemId], references: [id])
  addedAt     DateTime  @default(now())
}

// ── SPOTKANIA PVE ──────────────────────────────────────────────────────────────
model PveEncounter {
  id                Int       @id @default(autoincrement())
  characterId       Int
  character         Character @relation(fields: [characterId], references: [id])
 
  locationLevel     Int                    // 1–5 (poziom lokacji eksploracji)
  entityId          String                 // ID z minor-entities.ts (np. "air_wisp")
  entityName        String                 // Wyświetlana nazwa bytu
  playerWon         Boolean
  runicShardsEarned Int       @default(0)
 
  battleLog         String                 // JSON — pełny log walki (TurnLog[])
  summary           String                 // Np. "Powietrzny Błąd wygrywa po 3 turach!"
 
  foughtAt          DateTime  @default(now())
 
  @@index([characterId])
  @@index([characterId, playerWon])
}


// ── KSIĘGA MAGII ─────────────────────────────────────────────────────────────
// Śledzi, które czary gracz "odkrył" (widział w akcji/walce/szkole)
// NIE jest tym samym co posiadanie czaru (CharacterSpell)

model SpellbookEntry {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])

  // Źródło odkrycia: "study" | "battle_cast" | "school"
  source      String
  discoveredAt DateTime @default(now())

  @@unique([characterId, spellId])
  @@index([characterId])
}

model EquipmentPreset {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  slotIndex   Int       // 0–9
  name        String
  hatItemId       Int?
  robeItemId      Int?
  bootsItemId     Int?
  talismanItemId    Int?
  mainHandItemId  Int?
  offHandItemId   Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, slotIndex])
  @@index([characterId])
}

model CharacterUtilitySlots {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])
  slotIndex   Int       // 0–2

  @@unique([characterId, slotIndex])
  @@unique([characterId, spellId])
}

model MagicTournament {
  id           Int       @id @default(autoincrement())
  challengerId Int
  challenger   Character @relation("TournamentChallenger", fields: [challengerId], references: [id])
  defenderId   Int
  defender     Character @relation("TournamentDefender", fields: [defenderId], references: [id])
  winnerId     Int?
  winner       Character? @relation("TournamentWinner", fields: [winnerId], references: [id])
  log          String    // JSON: TournamentRoundLog[]
  summary      String
  metadata     String    @default("{}")
  prestigeGain Int       @default(0)
  foughtAt     DateTime  @default(now())

  @@index([challengerId])
  @@index([defenderId])
}

// ── TROFEA (system "zbieraczy") ───────────────────────
// Definicja trofeum — katalog wszystkich możliwych trofeów w grze.
// Unikalne przedmioty zdobywane za konkretne akcje gracza (np. "Pierwsza Krew", "Mistrz Wieży").
model Trophy {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("")
  icon        String   @default("") // np. nazwa pliku/ikony do frontendu
  category    String   @default("general") // grupowanie w UI, np. "combat"|"tower"|"tournament"|"misc"
  createdAt   DateTime @default(now())

  owners      CharacterTrophy[]
}

// Posiadanie trofeum przez postać — unikalne osiągnięcie, albo je masz, albo nie.
model CharacterTrophy {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  trophyId    Int
  trophy      Trophy    @relation(fields: [trophyId], references: [id])
  earnedAt    DateTime  @default(now())

  @@unique([characterId, trophyId])
  @@index([characterId])
}

// ═══════════════════════════════════════════════════════════════════
// WIADOMOŚCI SYSTEMOWE (A — losowe, C — level up, D — tutorial)
// ═══════════════════════════════════════════════════════════════════
model SystemMessage {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])

  type        String    // "random" | "levelup" | "tutorial"
  title       String?
  content     String

  sourceKey   String?   // dla "random": klucz z pliku źródłowego (anty-powtórka)

  isRead      Boolean   @default(false)
  isSaved     Boolean   @default(false)

  createdAt   DateTime  @default(now())

  @@index([characterId, type])
  @@index([characterId, isSaved])
  @@index([characterId, createdAt])
}

// Trwała historia wylosowanych komunikatów "random" — niezależna od cyklu
// życia SystemMessage (ta może zostać usunięta po 30 dniach, historia nie).
model SeenRandomMessage {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  sourceKey   String
  seenAt      DateTime  @default(now())

  @@unique([characterId, sourceKey])
  @@index([characterId])
}

// Znacznik "czy dzisiaj już losowaliśmy" — raz dziennie po zalogowaniu.
model DailyMessageRoll {
  id           Int       @id @default(autoincrement())
  characterId  Int       @unique
  character    Character @relation(fields: [characterId], references: [id])
  lastRollDate DateTime  // przechowujemy jako data o północy (UTC) dla łatwego porównania
}

// ═══════════════════════════════════════════════════════════════════
// WIADOMOŚCI PRYWATNE (B)
// ═══════════════════════════════════════════════════════════════════
model Conversation {
  id              Int       @id @default(autoincrement())

  participantAId  Int       // zawsze mniejsze id z pary (wymuszone w serwisie)
  participantA    Character @relation("ConversationAsA", fields: [participantAId], references: [id])
  participantBId  Int       // zawsze większe id z pary
  participantB    Character @relation("ConversationAsB", fields: [participantBId], references: [id])

  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())

  messages        PrivateMessage[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
}

model PrivateMessage {
  id                 Int          @id @default(autoincrement())
  conversationId     Int
  conversation       Conversation @relation(fields: [conversationId], references: [id])

  senderId           Int
  sender             Character    @relation("MessagesSent", fields: [senderId], references: [id])

  content            String       // max 1000 znaków — walidacja w serwisie

  isRead             Boolean      @default(false)
  isSavedBySender    Boolean      @default(false)
  isSavedByReceiver  Boolean      @default(false)

  createdAt          DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ═══════════════════════════════════════════════════════════════════
// BLOKOWANIE GRACZY
// ═══════════════════════════════════════════════════════════════════
model BlockedPlayer {
  id          Int       @id @default(autoincrement())
  blockerId   Int
  blocker     Character @relation("BlocksIssued", fields: [blockerId], references: [id])
  blockedId   Int
  blocked     Character @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// ═══════════════════════════════════════════════════════════════════
// COOLDOWN ANTY-SPAM (per para nadawca→odbiorca)
// ═══════════════════════════════════════════════════════════════════
model MessageCooldown {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  lastSentAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}