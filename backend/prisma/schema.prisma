generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── GRACZE ──────────────────────────────────────────
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  lastLoginAt  DateTime? 

  character    Character?
}

// ── POSTAĆ GRACZA ────────────────────────────────────
model Character {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level      Int @default(1)
  experience Int @default(0)

  equipment   CharacterEquipment?
  spellSlots  CharacterSpellSlots[]
  ownedItems  OwnedItem[]



  // Statystyki bazowe
  knowledge       Int @default(0)
  intelligence    Int @default(0)
  power           Int @default(0)
  endurance       Int @default(0)
  resistance      Int @default(0)
  initiative      Int @default(0)
  elementalMagic  Int @default(0)
  astralMagic     Int @default(0)
  bloodMagic      Int @default(0)

  // Zasoby
  powerShards         Int      @default(1)
  skillPoints         Int      @default(5)
  prestige            Int      @default(0)
  runicStoneShards    Int      @default(0)
  lastResourceCollect DateTime @default(now())
  maxSpells           Int      @default(2)

  // Rankingi — znacznik czasu ostatniego zdobycia poziomu (tie-breaker w rankingu poziomów)
  levelUpAt           DateTime @default(now())

  // Rankingi — liczniki walk PvP (klasyka piłkarska: 3/1/0)
  battleWins          Int      @default(0)
  battleLosses        Int      @default(0)
  battleDraws         Int      @default(0)

  // Rankingi — liczniki turniejów magicznych
  tournamentWins      Int      @default(0)
  tournamentLosses    Int      @default(0)
  tournamentDraws     Int      @default(0)

  // Pule akcji
  studyActions       Int      @default(30)
  explorationActions Int      @default(15)
  lastStudyRegen     DateTime @default(now())
  lastExploreRegen   DateTime @default(now())

  tower     Tower?
  spells    CharacterSpell[]
  items     CharacterItem[]
  actions   CharacterAction[]
  equipmentPresets EquipmentPreset[]
  
  battlesAsAttacker Battle[] @relation("BattleAttacker")
  battlesAsDefender Battle[] @relation("BattleDefender")
  battlesAsWinner   Battle[] @relation("BattleWinner")
  pveEncounters     PveEncounter[]
  spellbookEntries SpellbookEntry[]
  utilitySlots             CharacterUtilitySlots[]
  tournamentsAsChallenger  MagicTournament[] @relation("TournamentChallenger")
  tournamentsAsDefender    MagicTournament[] @relation("TournamentDefender")
  tournamentsAsWinner      MagicTournament[] @relation("TournamentWinner")

  tutorial  CharacterTutorial?
  homeRepairTasks HomeRepairTask[]
  trophies  CharacterTrophy[]
  systemMessages       SystemMessage[]
  seenRandomMessages    SeenRandomMessage[]
  dailyMessageRoll      DailyMessageRoll?
  conversationsAsA      Conversation[] @relation("ConversationAsA")
  conversationsAsB      Conversation[] @relation("ConversationAsB")
  privateMessagesSent   PrivateMessage[] @relation("MessagesSent")
  blocksIssued          BlockedPlayer[] @relation("BlocksIssued")
  blocksReceived        BlockedPlayer[] @relation("BlocksReceived")
  directedSchool       MagicSchool?    @relation("SchoolDirector")
  schoolMembership     SchoolMember?   @relation("SchoolMembership")
  libraryProposals     SchoolLibrarySpell[] @relation("LibraryProposals")
  libraryReviews       SchoolLibrarySpell[] @relation("LibraryReviews")
  schoolJoinRequests SchoolJoinRequest[] @relation("SchoolJoinRequests")
  riftTrophies        CharacterRiftTrophy[]
  stableRiftParties   StableRiftParty[]       @relation("StableRiftPartyLeader")
  stableRiftMembers   StableRiftMember[]      @relation("StableRiftMemberChar")
  riftRuns            RiftRun[]
  unstableRift        UnstableRift?
  riftTriggerProgress RiftTriggerProgress[]
  riftWorldHistory    RiftWorldHistory[]


}


model CharacterTutorial {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  step              String  @default("INTRO")
  duelUnlockShown   Boolean @default(false)
  schoolUnlockShown Boolean @default(false)

  updatedAt   DateTime @updatedAt
}

model HomeRepairTask {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])

  taskCode    String    // "FOUNDATIONS" | "WALLS" | "FURNITURE"
  status      String    @default("locked") // locked | available | in_progress | completed
  startedAt   DateTime?
  finishesAt  DateTime?
  completedAt DateTime?

  @@unique([characterId, taskCode])
}

// ── WIEŻA ────────────────────────────────────────────
model Tower {
  id                Int       @id @default(autoincrement())
  characterId       Int       @unique
  character         Character @relation(fields: [characterId], references: [id])
  level             Int       @default(1)
  isUpgrading       Boolean   @default(false)
  upgradeFinishesAt DateTime?
  updatedAt         DateTime  @updatedAt

  buildings TowerBuilding[]
}

model TowerBuilding {
  id                Int     @id @default(autoincrement())
  towerId           Int
  tower             Tower   @relation(fields: [towerId], references: [id])
  buildingType      String
  level             Int     @default(1)
  isUpgrading       Boolean @default(false)
  upgradeFinishesAt DateTime?
  config            String  @default("{}")

  @@unique([towerId, buildingType])
}

// ── CZARY ────────────────────────────────────────────
model Spell {
  id        Int    @id @default(autoincrement())
  name      String @unique

  // ── Kategoria ─────────────────────────────────────────────────────────────
  // "offensive" | "supportive" | "summoner" | "utility"
  category  String @default("offensive")

  // ── Info podstawowe ───────────────────────────────────────────────────────
  spellPool String @default("chaotic") // "chaotic"|"controlled"|"incantation"|"professional"|"master"
  rarity    String @default("common")  // "common"|"uncommon"|"rare"|"unique"
  basicCost Int    @default(0)
  element   String @default("none")

  // Opis w Księdze Magii (kafelek + modal)
  bookDescription String @default("")

  // ── Wymagania statystyk ───────────────────────────────────────────────────
  reqElementalMagic Int @default(0)
  reqAstralMagic    Int @default(0)
  reqBloodMagic     Int @default(0)

  // ── Czary bojowe — pola wspólne ───────────────────────────────────────────
  damage  Int     @default(0)
  special String?

  // Cel czaru ofensywnego/wspierającego
  // "randomEnemy"|"nEnemies"|"allEnemies"|"all"|"self"|"nAllies"|"allAllies"
  spellTarget      String? 
  spellTargetCount Int?    // tylko dla nEnemies / nAllies

  // Statusy nakładane przez czar — JSON: StatusEffectDef[]
  statusEffects String @default("[]")

  // Tekst wyświetlany gdy wygasają WSZYSTKIE statusy tego czaru (duration > 1)
  // Jedno pole na czar, niezależnie od liczby statusów
  endInfo String?

  // ── Czary summonerskie ────────────────────────────────────────────────────
  summonCount      Int    @default(0)
  summonHp         Int    @default(0)
  summonDamage     Int    @default(0)
  summonInitiative Int    @default(0)
  summonElement    String?
  summonTargetType String? // domyślny target minionów

  // Pula ataków minionów — JSON: MinionAttack[]
  // Każdy atak ma: name, damage, element, target, actionDesc, statusEffects[], weight
  minionAttacks String @default("[]")

  // ── Czary użytkowe ────────────────────────────────────────────────────────
  utilityEffect       String @default("{}")  // JSON: UtilityEffectDef
  utilityDescriptions String @default("{}")  // JSON: { "1": "...", ..., "5": "..." }

  // ── Flagi specjalne ───────────────────────────────────────────────────────
  isTutorialReward Boolean @default(false)

  // ── Relacje ───────────────────────────────────────────────────────────────
  spellSlots         CharacterSpellSlots[]
  characters         CharacterSpell[]
  spellbookEntries   SpellbookEntry[]
  utilitySlots       CharacterUtilitySlots[]
  schoolLibraryEntries SchoolLibrarySpell[]

}

model CharacterSpell {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id])
  spellId      Int
  spell        Spell     @relation(fields: [spellId], references: [id])
  isEquipped   Boolean   @default(false)
  discoveredAt DateTime  @default(now())

  @@unique([characterId, spellId])
}

// ── ARTEFAKTY ────────────────────────────────────────
model Item {
  id             Int    @id @default(autoincrement())
  name           String @unique
  rarity         String
  slot           String
  weaponType     String?
  element        String?

  reqKnowledge        Int @default(0)
  reqIntelligence     Int @default(0)
  reqPower            Int @default(0)
  reqEndurance        Int @default(0)
  reqResistance       Int @default(0)
  reqInitiative       Int @default(0)
  reqElementalMagic   Int @default(0)
  reqAstralMagic      Int @default(0)
  reqBloodMagic       Int @default(0)


  bonusKnowledge      Int @default(0)
  bonusIntelligence   Int @default(0)
  bonusPower          Int @default(0)
  bonusEndurance      Int @default(0)
  bonusResistance     Int @default(0)
  bonusInitiative     Int @default(0)
  bonusElementalMagic Int @default(0)
  bonusAstralMagic    Int @default(0)
  bonusBloodMagic     Int @default(0)

  characters CharacterItem[]
  ownedItems OwnedItem[]
  baseReqs      String   @default("{}")     // JSON: bazowe wymagania przed skalowaniem tierem
  baseBonus     String   @default("{}")     // JSON: bazowe bonusy przed skalowaniem tierem
  locationTypes String   @default("[]")     // JSON: ["A"] | ["A","B"] | ["A","B","C"] itd.
}

model OwnedItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  obtainedAt  DateTime  @default(now())
  tier Int @default(1)   // 1–10, losowany przy dropie

  vaultEntry ChaosVaultItem?

  equippedAsRobe     CharacterEquipment? @relation("EquipRobe")
  equippedAsBoots    CharacterEquipment? @relation("EquipBoots")
  equippedAsHat      CharacterEquipment? @relation("EquipHat")
  equippedAsTalisman   CharacterEquipment? @relation("EquipTalisman")
  equippedAsMainHand CharacterEquipment? @relation("EquipMainHand")
  equippedAsOffHand  CharacterEquipment? @relation("EquipOffHand")
  equippedAsOffHand2 CharacterEquipment? @relation("EquipOffHand2")

  @@index([characterId])
}

model CharacterItem {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  foundAt     DateTime  @default(now())
}

// ── AKTYWNY EKWIPUNEK POSTACI ────────────────────────
model CharacterEquipment {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])

  robeId     Int? @unique
  bootsId    Int? @unique
  hatId      Int? @unique
  talismanId   Int? @unique
  mainHandId Int? @unique
  offHandId  Int? @unique
  offHand2Id Int? @unique

  robe     OwnedItem? @relation("EquipRobe", fields: [robeId], references: [id])
  boots    OwnedItem? @relation("EquipBoots", fields: [bootsId], references: [id])
  hat      OwnedItem? @relation("EquipHat", fields: [hatId], references: [id])
  talisman   OwnedItem? @relation("EquipTalisman", fields: [talismanId], references: [id])
  mainHand OwnedItem? @relation("EquipMainHand", fields: [mainHandId], references: [id])
  offHand  OwnedItem? @relation("EquipOffHand", fields: [offHandId], references: [id])
  offHand2 OwnedItem? @relation("EquipOffHand2", fields: [offHand2Id], references: [id])
}

// ── AKTYWNE CZARY POSTACI ────────────────────────────
model CharacterSpellSlots {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])
  slotIndex   Int       // 0–9

  @@unique([characterId, slotIndex])
  @@unique([characterId, spellId])
}

// ── AKCJE GRACZA ─────────────────────────────────────
model CharacterAction {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  actionType  String    // "study" | "exploration"
  actionLevel Int       // 1–5
  status      String    @default("in_progress") // "in_progress"|"completed"|"claimed"
  startedAt   DateTime  @default(now())
  finishesAt  DateTime
  actionSubcategory Int?   // 1, 2 lub 3; null dla starych rekordów


  skillPointsEarned Int?
  spellDiscovered   String?
  report            String?

  @@index([characterId, status])
  explorationLocation  String?  // "A" | "B" | "C" — litera podkategorii eksploracji
}

// ── WALKI PVP ─────────────────────────────────────────
model Battle {
  id           Int       @id @default(autoincrement())
  attackerId   Int
  attacker     Character @relation("BattleAttacker", fields: [attackerId], references: [id])
  defenderId   Int
  defender     Character @relation("BattleDefender", fields: [defenderId], references: [id])
  winnerId     Int
  winner       Character @relation("BattleWinner", fields: [winnerId], references: [id])
  log          String
  summary      String
  metadata     String    @default("{}")
  prestigeGain Int       @default(0)
  foughtAt     DateTime  @default(now())

  @@index([attackerId])
  @@index([defenderId])
}

// ── KOMNATA NIEŁADU ───────────────────────────────────
model ChaosVaultItem {
  id          Int       @id @default(autoincrement())
  ownedItemId Int       @unique
  ownedItem   OwnedItem @relation(fields: [ownedItemId], references: [id])
  addedAt     DateTime  @default(now())
}

// ── SPOTKANIA PVE ──────────────────────────────────────────────────────────────
model PveEncounter {
  id                Int       @id @default(autoincrement())
  characterId       Int
  character         Character @relation(fields: [characterId], references: [id])
 
  locationLevel     Int                    // 1–5 (poziom lokacji eksploracji)
  entityId          String                 // ID z minor-entities.ts (np. "air_wisp")
  entityName        String                 // Wyświetlana nazwa bytu
  playerWon         Boolean
  runicShardsEarned Int       @default(0)
 
  battleLog         String                 // JSON — pełny log walki (TurnLog[])
  summary           String                 // Np. "Powietrzny Błąd wygrywa po 3 turach!"
 
  foughtAt          DateTime  @default(now())
 
  @@index([characterId])
  @@index([characterId, playerWon])
}


// ── KSIĘGA MAGII ─────────────────────────────────────────────────────────────
// Śledzi, które czary gracz "odkrył" (widział w akcji/walce/szkole)
// NIE jest tym samym co posiadanie czaru (CharacterSpell)

model SpellbookEntry {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])

  // Źródło odkrycia: "study" | "battle_cast" | "school"
  source      String
  discoveredAt DateTime @default(now())
  lastUpgradedAt DateTime?
  upgradeTier    Int    @default(0)

  @@unique([characterId, spellId])
  @@index([characterId])
}

model EquipmentPreset {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  slotIndex   Int       // 0–9
  name        String
  hatItemId       Int?
  robeItemId      Int?
  bootsItemId     Int?
  talismanItemId    Int?
  mainHandItemId  Int?
  offHandItemId   Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, slotIndex])
  @@index([characterId])
}

model CharacterUtilitySlots {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  spellId     Int
  spell       Spell     @relation(fields: [spellId], references: [id])
  slotIndex   Int       // 0–2

  @@unique([characterId, slotIndex])
  @@unique([characterId, spellId])
}

model MagicTournament {
  id           Int       @id @default(autoincrement())
  challengerId Int
  challenger   Character @relation("TournamentChallenger", fields: [challengerId], references: [id])
  defenderId   Int
  defender     Character @relation("TournamentDefender", fields: [defenderId], references: [id])
  winnerId     Int?
  winner       Character? @relation("TournamentWinner", fields: [winnerId], references: [id])
  log          String    // JSON: TournamentRoundLog[]
  summary      String
  metadata     String    @default("{}")
  prestigeGain Int       @default(0)
  foughtAt     DateTime  @default(now())

  @@index([challengerId])
  @@index([defenderId])
}

// ── TROFEA (system "zbieraczy") ───────────────────────
// Definicja trofeum — katalog wszystkich możliwych trofeów w grze.
// Unikalne przedmioty zdobywane za konkretne akcje gracza (np. "Pierwsza Krew", "Mistrz Wieży").
model Trophy {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("")
  icon        String   @default("") // np. nazwa pliku/ikony do frontendu
  category    String   @default("general") // grupowanie w UI, np. "combat"|"tower"|"tournament"|"misc"
  createdAt   DateTime @default(now())

  owners      CharacterTrophy[]
}

// Posiadanie trofeum przez postać — unikalne osiągnięcie, albo je masz, albo nie.
model CharacterTrophy {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  trophyId    Int
  trophy      Trophy    @relation(fields: [trophyId], references: [id])
  earnedAt    DateTime  @default(now())

  @@unique([characterId, trophyId])
  @@index([characterId])
}

// ═══════════════════════════════════════════════════════════════════
// WIADOMOŚCI SYSTEMOWE (A — losowe, C — level up, D — tutorial)
// ═══════════════════════════════════════════════════════════════════
model SystemMessage {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])

  type        String    // "random" | "levelup" | "tutorial"
  title       String?
  content     String

  sourceKey   String?   // dla "random": klucz z pliku źródłowego (anty-powtórka)

  isRead      Boolean   @default(false)
  isSaved     Boolean   @default(false)

  createdAt   DateTime  @default(now())

  @@index([characterId, type])
  @@index([characterId, isSaved])
  @@index([characterId, createdAt])
}

// Trwała historia wylosowanych komunikatów "random" — niezależna od cyklu
// życia SystemMessage (ta może zostać usunięta po 30 dniach, historia nie).
model SeenRandomMessage {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  sourceKey   String
  seenAt      DateTime  @default(now())

  @@unique([characterId, sourceKey])
  @@index([characterId])
}

// Znacznik "czy dzisiaj już losowaliśmy" — raz dziennie po zalogowaniu.
model DailyMessageRoll {
  id           Int       @id @default(autoincrement())
  characterId  Int       @unique
  character    Character @relation(fields: [characterId], references: [id])
  lastRollDate DateTime  // przechowujemy jako data o północy (UTC) dla łatwego porównania
}

// ═══════════════════════════════════════════════════════════════════
// WIADOMOŚCI PRYWATNE (B)
// ═══════════════════════════════════════════════════════════════════
model Conversation {
  id              Int       @id @default(autoincrement())

  participantAId  Int       // zawsze mniejsze id z pary (wymuszone w serwisie)
  participantA    Character @relation("ConversationAsA", fields: [participantAId], references: [id])
  participantBId  Int       // zawsze większe id z pary
  participantB    Character @relation("ConversationAsB", fields: [participantBId], references: [id])

  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())

  messages        PrivateMessage[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
}

model PrivateMessage {
  id                 Int          @id @default(autoincrement())
  conversationId     Int
  conversation       Conversation @relation(fields: [conversationId], references: [id])

  senderId           Int
  sender             Character    @relation("MessagesSent", fields: [senderId], references: [id])

  content            String       // max 1000 znaków — walidacja w serwisie

  isRead             Boolean      @default(false)
  isSavedBySender    Boolean      @default(false)
  isSavedByReceiver  Boolean      @default(false)

  createdAt          DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ═══════════════════════════════════════════════════════════════════
// BLOKOWANIE GRACZY
// ═══════════════════════════════════════════════════════════════════
model BlockedPlayer {
  id          Int       @id @default(autoincrement())
  blockerId   Int
  blocker     Character @relation("BlocksIssued", fields: [blockerId], references: [id])
  blockedId   Int
  blocked     Character @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// ═══════════════════════════════════════════════════════════════════
// COOLDOWN ANTY-SPAM (per para nadawca→odbiorca)
// ═══════════════════════════════════════════════════════════════════
model MessageCooldown {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  lastSentAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

// ═══════════════════════════════════════════════════════════════════
// SZKOŁA MAGII
// ═══════════════════════════════════════════════════════════════════

model MagicSchool {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  abbreviation String   @default("") 
  description String   @default("")
  emblem      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directorId  Int      @unique
  director    Character @relation("SchoolDirector", fields: [directorId], references: [id])

  members     SchoolMember[]
  buildings   SchoolBuilding[]
  library     SchoolLibrarySpell[]
  activeBonus SchoolActiveBonus[]
  joinRequests SchoolJoinRequest[]
  riftParties   StableRiftParty[]

}

// Rola w szkole: "deputy" = zastępca dyrektora, "member" = zwykły członek
model SchoolMember {
  id          Int       @id @default(autoincrement())
  schoolId    Int
  school      MagicSchool @relation(fields: [schoolId], references: [id])
  characterId Int       @unique  // gracz może być tylko w jednej szkole
  character   Character @relation("SchoolMembership", fields: [characterId], references: [id])
  role        String    @default("member") // "deputy" | "member"
  joinedAt    DateTime  @default(now())

  @@index([schoolId])
}

// Budynki szkoły
model SchoolBuilding {
  id                Int         @id @default(autoincrement())
  schoolId          Int
  school            MagicSchool @relation(fields: [schoolId], references: [id])
  buildingType      String      // "main_hall" | "astro_tower" | "library" | "rift_chamber" | "canteen"
  level             Int         @default(0) // 0 = nie wybudowany
  isUpgrading       Boolean     @default(false)
  upgradeFinishesAt DateTime?
  updatedAt         DateTime    @updatedAt

  @@unique([schoolId, buildingType])
}

// Czary w bibliotece szkolnej
model SchoolLibrarySpell {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  school      MagicSchool @relation(fields: [schoolId], references: [id])
  spellId     Int
  spell       Spell       @relation(fields: [spellId], references: [id])

  proposedById Int
  proposedBy   Character  @relation("LibraryProposals", fields: [proposedById], references: [id])
  proposedAt   DateTime   @default(now())

  status      String      @default("pending") // "pending" | "approved" | "rejected"
  reviewedById Int?
  reviewedBy   Character? @relation("LibraryReviews", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([schoolId, spellId])
  @@index([schoolId, status])
}

// Aktywne bonusy stołówki (dyrektor/zastępca wybiera max N bonusów)
model SchoolActiveBonus {
  id       Int         @id @default(autoincrement())
  schoolId Int
  school   MagicSchool @relation(fields: [schoolId], references: [id])
  bonusKey String      // "stats" | "item_find" | "spell_find" | "hp" | "rift" | "dodge" | "spell_slot" | "utility_slot"

  @@unique([schoolId, bonusKey])
}

// Prośby o dołączenie do szkoły (wymagają akceptacji dyrektora/zastępcy)
model SchoolJoinRequest {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  school      MagicSchool @relation(fields: [schoolId], references: [id])
  characterId Int
  character   Character   @relation("SchoolJoinRequests", fields: [characterId], references: [id])
  status      String      @default("pending") // "pending" | "approved" | "rejected"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([schoolId, characterId])
  @@index([schoolId, status])
  @@index([characterId])
}

model RiftTrophy {
  id          Int      @id @default(autoincrement())
  key         String   @unique  // np. "stokrotka" | "pierscien_z_dziwnymi_znakami"
  name        String   @unique  // wyświetlana nazwa, np. "Stokrotka"
  description String   @default("")
  icon        String   @default("")  // nazwa pliku grafiki, np. "trophy_daisy.png"
  riftKey     String   // szczelina, w której można zdobyć, np. "green" | "red"
  bonuses     String   @default("{}")  // JSON: RiftTrophyBonuses (patrz typy)
  createdAt   DateTime @default(now())

  owners      CharacterRiftTrophy[]
}

// ── POSIADANIE TROFEUM PRZEZ POSTAĆ ─────────────────────────────
// Unikalne — gracz albo ma trofeum, albo nie.
// earnedInRiftKey — z jakiej szczeliny pochodzi (dla historii).
// earnedInWorldKey — z jakiej krainy pochodzi (dla historii).

model CharacterRiftTrophy {
  id            Int        @id @default(autoincrement())
  characterId   Int
  character     Character  @relation(fields: [characterId], references: [id])
  trophyId      Int
  trophy        RiftTrophy @relation(fields: [trophyId], references: [id])

  earnedInRiftKey  String  // np. "green"
  earnedInWorldKey String  // np. "stokrotka"

  earnedAt      DateTime   @default(now())

  @@unique([characterId, trophyId])  // gracz może mieć trofeum tylko raz
  @@index([characterId])
}

model UnstableRift {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id])
  riftKey     String
  worldKey    String
  status      String    @default("open")
  openedAt    DateTime  @default(now())
  enteredAt   DateTime?
  finishedAt  DateTime?
  runs        RiftRun[]

  @@index([characterId, status])
}


model RiftRun {
  id          Int          @id @default(autoincrement())
  riftId      Int
  rift        UnstableRift @relation(fields: [riftId], references: [id])
  characterId Int
  character   Character    @relation(fields: [characterId], references: [id])
  worldKey    String
  status      String       @default("in_progress")
  xpEarned        Int?
  prestigeEarned  Int?
  itemOwnedItemId Int?
  trophyId        Int?
  xpModifier      Int      @default(0)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  steps       RiftRunStep[]

  @@index([characterId])
}

model RiftRunStep {
  id        Int     @id @default(autoincrement())
  runId     Int
  run       RiftRun @relation(fields: [runId], references: [id])
  stepIndex Int
  nodeKey   String
  choiceKey String
  testRolled    Boolean?
  testSuccess   Boolean?
  fightOccurred Boolean?
  fightWon      Boolean?
  fightLog      String?
  resolvedAt DateTime @default(now())

  @@index([runId])
}

model StableRiftParty {
  id          Int         @id @default(autoincrement())
  schoolId    Int
  school      MagicSchool @relation(fields: [schoolId], references: [id])
  leaderId    Int
  leader      Character   @relation("StableRiftPartyLeader", fields: [leaderId], references: [id])
  riftKey     String
  status      String      @default("forming")
  createdAt   DateTime    @default(now())
  scheduledAt DateTime?
  finishedAt  DateTime?
  members     StableRiftMember[]
  run         StableRiftRun?

  @@index([schoolId, status])
  @@index([leaderId])
}

model StableRiftMember {
  id          Int             @id @default(autoincrement())
  partyId     Int
  party       StableRiftParty @relation(fields: [partyId], references: [id])
  characterId Int
  character   Character       @relation("StableRiftMemberChar", fields: [characterId], references: [id])
  status      String          @default("pending")
  joinedAt    DateTime        @default(now())

  @@unique([partyId, characterId])
  @@index([partyId, status])
  @@index([characterId])
}

model StableRiftRun {
  id        Int             @id @default(autoincrement())
  partyId   Int             @unique
  party     StableRiftParty @relation(fields: [partyId], references: [id])
  riftKey   String
  worldKey  String
  success   Boolean
  results   String          @default("[]")
  battleLogs String         @default("[]")
  foughtAt  DateTime        @default(now())

  @@index([partyId])
}

model RiftTriggerProgress {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  riftKey     String
  actionCount Int       @default(0)  // liczba akcji od ostatniego resetu

  @@unique([characterId, riftKey])
  @@index([characterId])
}

model RiftWorldHistory {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  riftKey     String
  worldKey    String
  visitedAt   DateTime  @default(now())

  @@index([characterId, riftKey])
}